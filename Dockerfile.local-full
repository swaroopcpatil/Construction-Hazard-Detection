FROM python:3.14-slim-bookworm

WORKDIR /app

COPY pyproject.toml uv.lock /app/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl ffmpeg fonts-noto-core fonts-noto-cjk libglib2.0-0 libgl1 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir "uv==0.9.9" \
    && uv export --quiet --format=requirements-txt --no-dev --no-emit-project \
        --no-hashes --no-annotate --frozen \
        --extra streaming --extra yolo --extra notification --extra violation \
        -o /tmp/requirements.txt \
    && grep -v -E '^(cuda-|nvidia-cu|nvidia-nccl|nvidia-nvjitlink|nvidia-nvshmem|nvidia-nvtx|torch==|torchvision==|triton==)' /tmp/requirements.txt \
        > /tmp/requirements-without-torch.txt \
    && uv pip install --system --no-deps -r /tmp/requirements-without-torch.txt \
    && uv pip install --system --no-deps \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.13.0+cpu torchvision==0.28.0+cpu \
    && rm -rf /root/.cache/pip /root/.cache/uv /tmp/requirements*

COPY main.py /app/main.py
COPY src /app/src
COPY examples /app/examples
COPY config /app/config

RUN useradd --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app

USER appuser

CMD ["python", "main.py"]
